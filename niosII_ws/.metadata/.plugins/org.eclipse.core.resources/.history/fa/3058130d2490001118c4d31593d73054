static const uint32_t word = 0xFF000000;

int count_leading_ones()
{
	uint32_t leading_ones = 0;

	for ( int i = 31; i >= 0; i--)
	{
		uint32_t bit = (value >> i) & 1;
		if !(bit)
				break;
		++leading_ones;
	}

	return leading_ones;
}

